// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookStatus {
  WISHLIST
  READ
  READING
}

// === MODELES POUR READING DASHBOARD ===
model Books {
  id String @id @onCreate(uuid())
  title String @unique
  author String
  genre String
  publicationDate Date
  pages Int
  isbn String
  startedDate Date
  endedDate Date
  readingStatus BookStatus @default(WISHLIST)
}
